{
  "name": "gnitoapp-com-site",
  "version": "0.1.0",
  "description": "Source for gnitoapp.com: product pages, APK downloads, legal pages.",
  "repository": "github:gnitoapp-com/gnitoapp-com.github.io",
  "homepage": "https://gnitoapp.com",
  "author": "GnitoApp.com (3827992 Canada Inc.)",
  "license": "UNLICENSED",
  "bugs": "https://github.com/gnitoapp-com/gnitoapp-com.github.io/issues",
  "scripts": {
    "_hugo": "hugo --cleanDestinationDir",
    "_hugo-dev": "npm run _hugo -- -e dev -DFE",
    "_serve": "npm run _hugo-dev -- --minify serve --renderToMemory",
    "serve": "npm run _serve",
    "build:production": "npm run _hugo -- --minify",
    "postbuild:production": "npm run _check:links",
    "_check:links": "./scripts/check-links.sh",
    "check:links": "npm run _check:links",
    "check:links:external": "./scripts/check-links.sh --external",
    "check:apk": "./scripts/apk-checksums.sh --check && ./scripts/apk-checksums.sh --rendered public",
    "lint:html": "html-validate public/index.html public/units2units/index.html public/forceworkouthelper/index.html public/romanitaire/index.html public/privacy/index.html public/terms/index.html public/support/index.html public/404.html",
    "spell": "cspell --no-progress \"content/**/*.md\" \"data/**/*.yaml\"",
    "smoke": "./scripts/smoke-test.sh https://gnitoapp.com",
    "verify": "npm run check:apk && npm run spell && npm run lint:html && npm run check:links",
    "clean": "rm -Rf public/* resources",
    "postinstall": "node scripts/ensure-dart-sass.mjs",
    "update:hugo": "npm install --save-dev --save-exact hugo-extended@latest",
    "update:pkgs": "npx npm-check-updates -u"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "cspell": "^10.4.0",
    "html-validate": "^11.17.0",
    "hugo-extended": "0.169.0",
    "postcss": "^8.5.3",
    "postcss-cli": "^12.0.0",
    "rtlcss": "^4.3.0",
    "sass-embedded": "1.105.0"
  },
  "optionalDependencies": {
    "npm-check-updates": "^23.1.1"
  },
  "private": true,
  "prettier": {
    "proseWrap": "always",
    "singleQuote": true
  },
  "workspaces": [
    "packages/hugoautogen"
  ]
}
