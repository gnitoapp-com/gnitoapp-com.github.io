{
  "name": "docsy-example-site",
  "version": "0.10.0",
  "version.next": "0.10.1-dev.0-unreleased",
  "description": "Example site that uses Docsy theme for technical documentation.",
  "repository": "github:google/docsy-example",
  "homepage": "https://example.docsy.dev",
  "author": "Docsy Authors",
  "license": "Apache-2.0",
  "bugs": "https://github.com/google/docsy-example/issues",
  "spelling": "cSpell:ignore docsy hugo htmltest precheck postbuild rtlcss -",
  "scripts": {
    "_build": "npm run _hugo-dev --",
    "postinstall": "node scripts/ensure-dart-sass.mjs",
    "_check:links": "./scripts/check-links.sh",
    "_hugo": "hugo --cleanDestinationDir",
    "_hugo-dev": "npm run _hugo -- -e dev -DFE",
    "_local": "npx cross-env HUGO_MODULE_WORKSPACE=docsy.work",
    "_serve": "npm run _hugo-dev -- --minify serve --renderToMemory",
    "build:preview": "npm run _hugo-dev -- --minify --baseURL \"${DEPLOY_PRIME_URL:-/}\"",
    "build:production": "npm run _hugo -- --minify",
    "build": "npm run _build -- ",
    "check:links:all": "HTMLTEST_ARGS= npm run _check:links",
    "check:links": "npm run _check:links",
    "clean": "rm -Rf public/* resources",
    "local": "npm run _local -- npm run",
    "make:public": "git init -b main public",
    "precheck:links:all": "npm run build",
    "precheck:links": "npm run build",
    "postbuild:preview": "npm run _check:links",
    "postbuild:production": "npm run _check:links",
    "serve": "npm run _serve",
    "test": "npm run check:links",
    "update:dep": "npm install --save-dev autoprefixer@latest postcss-cli@latest",
    "update:hugo": "npm install --save-dev --save-exact hugo-extended@latest",
    "update:pkgs": "npx npm-check-updates -u",
    "check:apk": "./scripts/apk-checksums.sh --check && ./scripts/apk-checksums.sh --rendered public",
    "check:links:external": "./scripts/check-links.sh --external",
    "lint:html": "html-validate public/index.html public/units2units/index.html public/forceworkouthelper/index.html public/romanitaire/index.html public/privacy/index.html public/terms/index.html public/support/index.html public/search/index.html public/404.html",
    "spell": "cspell --no-progress \"content/**/*.md\" \"data/**/*.yaml\"",
    "smoke": "./scripts/smoke-test.sh https://gnitoapp.com",
    "verify": "npm run check:apk && npm run spell && npm run lint:html && npm run check:links"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "cspell": "^10.4.0",
    "html-validate": "^11.17.0",
    "hugo-extended": "0.169.0",
    "postcss": "^8.5.3",
    "postcss-cli": "^12.0.0",
    "rtlcss": "^4.3.0",
    "sass-embedded": "1.105.0"
  },
  "optionalDependencies": {
    "npm-check-updates": "^23.1.1"
  },
  "private": true,
  "prettier": {
    "proseWrap": "always",
    "singleQuote": true
  },
  "workspaces": [
    "packages/hugoautogen"
  ]
}
