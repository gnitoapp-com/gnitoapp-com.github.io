#!/usr/bin/env bash
# Run the project-pinned Hugo with the toolchain it needs.
#
#   ./scripts/hugo version
#   ./scripts/hugo server --port 1313
#   ./scripts/hugo mod npm pack
#
# There is no system-wide `hugo` on this machine: the binary is the
# `hugo-extended` devDependency, so it only exists inside node_modules. This
# wrapper puts it (and, for module operations, Go) on PATH, then execs it.
#
# Why the PATH juggling matters: Docsy 0.17+ compiles SCSS with Dart Sass, and
# Hugo looks up a `sass` executable on PATH. node_modules/.bin/sass is linked at
# sass-embedded's embedded-protocol CLI by scripts/ensure-dart-sass.mjs
# (postinstall); running Hugo with a PATH that lacks node_modules/.bin fails
# with "TOCSS-DART ... got unexpected EOF when executing sass".
set -euo pipefail

# Resolve symlinks so this can be linked into ~/.local/bin as a global `hugo`.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
cd "$(cd -P "$(dirname "$SOURCE")" && pwd)/.."

if [[ ! -x node_modules/.bin/hugo ]]; then
  echo "error: Hugo is not installed - run 'npm ci' first (it also links Dart Sass)." >&2
  exit 1
fi

export PATH="$PWD/node_modules/.bin:$PATH"

# Hugo needs Go to resolve the Docsy module (go.mod / go.sum).
if ! command -v go >/dev/null 2>&1; then
  for candidate in "$HOME/.local/go-sdk/bin" /usr/local/go/bin; do
    if [[ -x "$candidate/go" ]]; then
      export PATH="$candidate:$PATH"
      break
    fi
  done
fi

exec hugo "$@"
